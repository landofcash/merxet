{
  "name": "@merxet/mcp",
  "version": "1.0.0",
  "description": "Local Codex MCP bridge for Merxet browser-approved testnet orders",
  "type": "module",
  "bin": { "merxet-mcp": "dist/server.js" },
  "main": "./dist/server.js",
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "start": "node dist/server.js"
  },
  "engines": { "node": ">=22.0.0" },
  "dependencies": {
    "@merxet/order-protocol": "1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
