# Copy to .env.local. Never put the signing key in a VITE_ variable.
WORLD_ENABLED=false
WORLD_DB_PATH=data/verifications.sqlite
WORLD_SELLER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://merxet.com
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=selfie-check-demo
# Sandbox requires app enablement AND tester access to the Sandbox phone app.
WORLD_ENVIRONMENT=sandbox
WORLD_REQUEST_TTL_SECONDS=300
WORLD_PROVIDER_TIMEOUT_MS=15000

# Open this exact origin in your browser. For a remote HTTPS demo, set it to
# the public origin and set HOST=0.0.0.0. Seller handoffs authenticate a signed wallet challenge.
APP_ORIGIN=http://localhost:4310
HOST=127.0.0.1
PORT=4310
