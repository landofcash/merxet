# Public storefront builder API origin used for verified ENS catalog names.
# This is the builder API origin, not the public shop origin or ENS RPC URL.
# Leave empty to display catalog IDs without ENS lookup.
VITE_STOREFRONT_API_ORIGIN=http://localhost:4180

# Agent-order quote and confirmation service origins.
VITE_MERXET_QUOTE_ORIGIN=https://x402.merxet.com
VITE_MERXET_RESOURCE_ORIGIN=https://x402.merxet.com

# Public verification metadata for signed agent-order quotes on Hedera testnet.
# Replace these placeholders with the topic and public signing-key metadata
# published by the configured quote service before enabling agent orders.
VITE_MERXET_HCS_TOPIC_ID=0.0.0
VITE_MERXET_QUOTE_KEY_ID=configure-before-agent-orders
VITE_MERXET_QUOTE_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional World verification; false or an empty URL makes no World requests.
VITE_WORLD_ENABLED=false
VITE_WORLD_API_URL=
